#
# smoketest: check, from inside the guest, the machine behaviours kelder
# relies on. Run it in a throwaway machine after upgrading smolvm or QEMU:
#
#   VM=kelder-test kelder self setup
#   VM=kelder-test kelder     then, in that session: smoketest [DIR]
#
# DIR is an attached host directory (default: the current directory).
# PASS/FAIL lines are behaviour kelder needs; KNOWN lines are smolvm bugs
# the guest config works around; CHANGED lines mean a known bug is gone and its
# workaround may be removable. A QEMU machine has neither the bugs nor the
# workarounds, so there those checks are plain PASS/FAIL. Exits non-zero if
# anything FAILs.
set -uo pipefail

dir=${1:-$PWD}
# smolvm's init lives in /run/smolvm; a QEMU machine boots a stock Debian.
if [[ -d /run/smolvm ]]; then backend=smolvm; else backend=qemu; fi
image=docker.io/library/python:3-slim
fails=0
pass()    { printf 'PASS     %s\n' "$1"; }
fail()    { printf 'FAIL     %s\n' "$1"; fails=$((fails + 1)); }
known()   { printf 'KNOWN    %s\n' "$1"; }
changed() { printf 'CHANGED  %s\n' "$1"; }

# --- users -------------------------------------------------------------------
uid=$(id -u)
if [[ $backend == smolvm ]]; then
  who=root
  if [[ $uid == 0 ]]; then pass "exec session runs as root"
  else fail "exec session runs as uid $uid, expected 0"; fi

  pid1=$(ps -o uid= -p 1 | tr -d ' ')
  if [[ $pid1 == 0 ]]; then pass "PID 1 runs as root"
  else fail "PID 1 runs as uid $pid1, expected 0"; fi
else
  # Sessions run as a user with the host user's uid, who may sudo.
  who="the session"
  owner=$(stat -c %u "$dir")
  if [[ $uid == "$owner" ]]; then pass "session runs as uid $uid, the owner of $dir"
  else fail "session runs as uid $uid, $dir belongs to uid $owner"; fi

  if sudo -n true 2>/dev/null; then pass "sudo works without a password"
  else fail "sudo needs a password or is not allowed"; fi
fi

# --- attached directory ownership --------------------------------------------
if ! tmp=$(mktemp -p "$dir" .smoketest.XXXXXX); then
  fail "cannot create a file in $dir"
else
  owner=$(stat -c %u "$dir")
  got=$(stat -c %u "$tmp")
  if [[ $got == "$owner" ]]; then
    rm -f "$tmp"
    pass "files $who creates in $dir belong to uid $owner, the directory's owner"
  else
    fail "files $who creates in $dir belong to uid $got, the directory belongs to uid $owner (kept $tmp)"
  fi
fi

# --- containers --------------------------------------------------------------
if ! podman pull -q "$image" >/dev/null; then
  fail "cannot pull $image; container checks skipped"
else
  # On smolvm, a connected UDP socket in a container netns fails on its 2nd
  # send (EINVAL).
  udp='import socket
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.connect(("1.1.1.1", 53))
try:
    s.send(b"x"); s.send(b"x"); print("ok")
except OSError as e:
    print(e.errno)'
  # Only what the check prints decides: podman's own warnings go to stderr.
  r=$(podman run --rm "$image" python3 -c "$udp")
  case $backend:$r in
    smolvm:ok) changed "connected UDP in containers works; the TSI bug may be fixed" ;;
    smolvm:22) known "connected UDP in containers fails on the 2nd send (EINVAL)" ;;
    qemu:ok)   pass "connected UDP in containers works" ;;
    *)         fail "container UDP check gave: $r" ;;
  esac

  if [[ $backend == smolvm ]]; then
    if podman run --rm "$image" getent ahosts deb.debian.org >/dev/null; then
      pass "container DNS resolves with containers-tsi.conf"
    else
      fail "container DNS fails even with containers-tsi.conf"
    fi

    override=$(mktemp)
    printf '[containers]\ndns_options = []\n' >"$override"
    if CONTAINERS_CONF_OVERRIDE=$override podman run --rm "$image" \
         getent ahosts deb.debian.org >/dev/null; then
      changed "container DNS works without single-request-reopen; containers-tsi.conf may be removable"
    else
      known "container DNS fails without single-request-reopen"
    fi
    rm -f "$override"
  elif podman run --rm "$image" getent ahosts deb.debian.org >/dev/null; then
    pass "container DNS resolves"
  else
    fail "container DNS fails"
  fi
fi

# --- nested VMs --------------------------------------------------------------
if testvm run -- true; then pass "testvm boots a nested VM"
else fail "testvm cannot boot a nested VM"; fi

echo
if ((fails)); then echo "$fails check(s) failed"; exit 1; fi
echo "all checks passed"
